# GitHub API
GITHUB_TOKEN=

# AI provider: offline, openai, or anthropic
AI_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# API authentication. API_KEYS accepts a comma-separated rotation set.
API_KEYS=
SNB_ENV=development

# Optional: comma-separated allowed Host headers.
# Example: security-network-builder.onrender.com
SNB_ALLOWED_HOSTS=
